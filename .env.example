# Veritabanı Ayarları
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=kalite_portal
DB_PORT=3306

# Uygulama Ayarları
APP_NAME="Kalite Standartları Portalı"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_SECRET=your-secret-key-change-this

# Upload Ayarları
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf
UPLOAD_DIR=uploads

# Email Ayarları (Opsiyonel)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Kalite Portalı

# Session
SESSION_LIFETIME=3600

# Timezone
TIMEZONE=Europe/Istanbul
